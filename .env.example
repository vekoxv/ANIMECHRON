# Optional. Copy to .env.local. Keys are read on the server only and never reach the browser.

# IMDb ratings read live through OMDb (https://www.omdbapi.com/apikey.aspx).
# Without it, IMDb values come from the dated IMDb dataset snapshot.
OMDB_API_KEY=

# TMDB user scores (https://www.themoviedb.org/settings/api). Without it TMDB shows "Unavailable".
# Set it before `npm run snapshot` too if you want TMDB in the stored snapshot.
TMDB_API_KEY=
